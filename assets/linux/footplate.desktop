# footplate's entry for the menu of applications, as the Linux archive carries
# it. Copied to ~/.local/share/applications, with the footplate of the same
# archive in ~/.local/bin (README.md, "Installing").
#
# Exec goes through sh because an entry cannot name a home folder, and
# ~/.local/bin is on no desktop's PATH unless its owner put it there. What sh
# is given is
#   exec "$HOME/.local/bin/footplate"
# and the backslashes are the entry format's escape and the Exec key's quoting
# together, which is why they come in pairs.
#
# The name leads with yardr so the app sorts under Y, next to yardr, in
# the menu of applications.
[Desktop Entry]
Type=Application
Version=1.0
Name=yardr footplate
GenericName=Chat client
Comment=Talk with the crew of a yardr yard
Exec=sh -c "exec \\"\\$HOME/.local/bin/footplate\\""
Icon=footplate
Terminal=false
Categories=Network;Chat;
Keywords=footplate;yardr;yard;chat;
StartupWMClass=footplate
