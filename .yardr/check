#!/bin/sh
# The merge gate of depot footplate: yardr depot check runs it in a bead's
# worktree, and a bead lands only when it exits 0. yardr reads this file from
# the base branch (main), so an edit here counts once it has landed there.
set -e
# rustup installs into the home, which the yard's processes may not have on PATH.
export PATH="$HOME/.cargo/bin:$PATH"
# From the lockfile, so the gate builds what a clean checkout builds.
cargo fmt --all -- --check
cargo clippy --all-targets --locked -- -D warnings
cargo test --locked
cargo build --locked
